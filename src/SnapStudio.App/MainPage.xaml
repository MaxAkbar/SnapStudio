                                    <StackPanel Spacing="8" Margin="0,8,0,8" Visibility="{x:Bind ViewModel.StampControlsVisibility, Mode=OneWay}">
                                        <TextBlock Text="Click the image to place copies. Use Move (V) to move or resize a placed stamp." TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource SnapMutedBrush}"/>
