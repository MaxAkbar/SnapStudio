                                            StepFrequency="{x:Bind ViewModel.AnnotationSizeStepFrequency, Mode=OneWay}"
                                            Value="{x:Bind ViewModel.AnnotationSizeSliderValue, Mode=OneWay}"
                                            ValueChanged="AnnotationStrokeSize_ValueChanged"
                                            Height="28" MinHeight="0"/>
                                    </Grid>
                                    <Grid ColumnSpacing="8" MinHeight="38" Visibility="{x:Bind ViewModel.AnnotationColorControlsVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.AnnotationColorHeader, Mode=OneWay}" FontSize="10" VerticalAlignment="Center" Foreground="{ThemeResource SnapMutedBrush}"/>
                                        <Button
                                            AutomationProperties.HelpText="Open the custom annotation color picker."
                                            AutomationProperties.Name="Custom annotation color"
                                            Visibility="{x:Bind ViewModel.AnnotationColorControlsVisibility, Mode=OneWay}"
                                            ToolTipService.ToolTip="Custom color"
                                            Style="{StaticResource WorkspaceCommandButtonStyle}"
                                            Height="28"
                                            MinHeight="0"
                                            Padding="5,0"
                                            MinWidth="88"
                                            Grid.Column="1">
                                            <Button.Flyout>
                                                <Flyout>
                                                    <ColorPicker AutomationProperties.HelpText="Choose a custom annotation color." AutomationProperties.Name="Custom annotation color picker" Color="{x:Bind WorkspaceAnnotationColor, Mode=OneWay}" ColorChanged="AnnotationCustomColor_ColorChanged" IsAlphaEnabled="False"/>
                                                </Flyout>
                                            </Button.Flyout>
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Border Width="16" Height="16" CornerRadius="3" Background="{x:Bind WorkspaceStrokeBrush, Mode=OneWay}"/>
                                                <TextBlock Text="{x:Bind WorkspaceColorHex, Mode=OneWay}" FontSize="9" VerticalAlignment="Center" CharacterSpacing="30"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <StackPanel
                                        AutomationProperties.HelpText="Choose the annotation stroke color."
                                        AutomationProperties.Name="Annotation color"
                                        Visibility="{x:Bind ViewModel.AnnotationColorControlsVisibility, Mode=OneWay}"
                                        Orientation="Horizontal"
                                        Spacing="9"
                                        HorizontalAlignment="Right"
                                        Margin="0,5,0,7">
                                        <Button
                                            Background="#4CC2FF"
                                            Click="AnnotationStrokeButton_Click"
                                            Style="{StaticResource SwatchButtonStyle}"
                                            Tag="0"
                                            ToolTipService.ToolTip="Sky blue"
                                            Width="17"
                                            Height="17"
                                            MinWidth="17"
                                            MinHeight="17"
                                            CornerRadius="9" />
                                        <Button
                                            Background="#FFFFFF"
                                            Click="AnnotationStrokeButton_Click"
                                            Style="{StaticResource SwatchButtonStyle}"
                                            Tag="1"
                                            ToolTipService.ToolTip="White"
                                            Width="17"
                                            Height="17"
                                            MinWidth="17"
                                            MinHeight="17"
                                            CornerRadius="9" />
                                        <Button
                                            Background="#FFB85C"
                                            Click="AnnotationStrokeButton_Click"
                                            Style="{StaticResource SwatchButtonStyle}"
                                            Tag="2"
                                            ToolTipService.ToolTip="Amber"
                                            Width="17"
                                            Height="17"
                                            MinWidth="17"
                                            MinHeight="17"
                                            CornerRadius="9" />
                                        <Button
                                            Background="#FF747D"
                                            Click="AnnotationStrokeButton_Click"
                                            Style="{StaticResource SwatchButtonStyle}"
                                            Tag="3"
                                            ToolTipService.ToolTip="Coral"
                                            Width="17"
                                            Height="17"
                                            MinWidth="17"
                                            MinHeight="17"
                                            CornerRadius="9" />
                                        <Button
                                            Background="#94DCB1"
                                            Click="AnnotationStrokeButton_Click"
                                            Style="{StaticResource SwatchButtonStyle}"
                                            Tag="4"
                                            ToolTipService.ToolTip="Mint"
                                            Width="17"
                                            Height="17"
                                            MinWidth="17"
                                            MinHeight="17"
                                            CornerRadius="9" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="8" MinHeight="38" Visibility="{x:Bind ViewModel.AnnotationFillControlsVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Fill" FontSize="10" VerticalAlignment="Center" Foreground="{ThemeResource SnapMutedBrush}"/>
                                        <Button
                                            Style="{StaticResource WorkspaceCommandButtonStyle}"
                                            Click="WorkspaceFill_Click"
                                            ToolTipService.ToolTip="Use the fill bucket to color a shape or image area"
                                            Height="27"
                                            Padding="8,0"
                                            FontSize="9"
                                            Grid.Column="1">
                                            <TextBlock Text="Fill bucket" FontSize="9" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                    <Grid ColumnSpacing="8" MinHeight="38" Visibility="{x:Bind ViewModel.AnnotationOpacityControlsVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.AnnotationOpacityHeader, Mode=OneWay}" FontSize="10" VerticalAlignment="Center" Foreground="{ThemeResource SnapMutedBrush}"/>
                                        <Slider
                                            AutomationProperties.HelpText="Set annotation opacity."
                                            AutomationProperties.Name="{x:Bind ViewModel.AnnotationOpacityHeader, Mode=OneWay}"
                                            Maximum="1"
                                            Minimum="0.1"
                                            StepFrequency="0.05"
                                            Value="{x:Bind ViewModel.AnnotationOpacity, Mode=OneWay}"
                                            ValueChanged="AnnotationOpacity_ValueChanged"
                                            Width="100"
                                            Height="28"
                                            MinHeight="0"
                                            Grid.Column="1" />
                                        <TextBlock
                                            Text="{x:Bind WorkspaceOpacityLabel, Mode=OneWay}"
                                            FontSize="10"
                                            VerticalAlignment="Center"
                                            MinWidth="32"
                                            TextAlignment="Right"
                                            Grid.Column="2" />
                                    </Grid>
                                    <Grid ColumnSpacing="8" MinHeight="38" Visibility="{x:Bind ViewModel.AnnotationCornerStyleControlsVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
