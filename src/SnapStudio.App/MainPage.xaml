                                                            <controls:GridFamilyEditor Title="Right VP" Settings="{x:Bind ViewModel.RightGridStyle, Mode=TwoWay}" Visibility="{x:Bind ViewModel.SideGridFamiliesVisibility, Mode=OneWay}"/>
