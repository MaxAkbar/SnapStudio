                                                Grid.Column="1"
                                                Padding="4,1"
                                                CornerRadius="4"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource SnapPanelAltBrush}"
                                                Margin="7,0,0,0">
                                                <TextBlock FontSize="10" Text="{x:Bind ViewModel.AnnotationLayerCount, Mode=OneWay}"/>
                                            </Border>
                                            <FontIcon x:Name="LayersSectionChevron" Grid.Column="3" Glyph="" FontSize="10"/>
