                                            Value="{x:Bind ViewModel.StampSize, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                        <Button Content="Choose stamp…" Click="StampToolButton_Click" HorizontalAlignment="Stretch"/>
                                        <Button Content="Import SVG stamp…" Click="ImportStamp_Click" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <Button Content="Crop selected area" Click="CropButton_Click" HorizontalAlignment="Stretch"
                                        IsEnabled="{x:Bind ViewModel.CanCropToSelection, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.AnnotationSelectionCropVisibility, Mode=OneWay}"/>
                                    <StackPanel Spacing="8" Margin="0,6,0,8" Visibility="{x:Bind ViewModel.PixelSelectionControlsVisibility, Mode=OneWay}">
                                        <ComboBox Header="Selection tool" AutomationProperties.Name="Selection tool" HorizontalAlignment="Stretch"
                                            SelectedIndex="{x:Bind ViewModel.PixelSelectionToolIndex, Mode=TwoWay}">
                                            <x:String>Rectangular marquee</x:String><x:String>Elliptical marquee</x:String><x:String>Lasso</x:String>
                                            <x:String>Magic wand</x:String><x:String>Polygonal lasso</x:String>
                                        </ComboBox>
                                        <ComboBox Header="Selection mode" AutomationProperties.Name="Selection mode" HorizontalAlignment="Stretch"
                                            SelectedIndex="{x:Bind ViewModel.PixelSelectionModeIndex, Mode=TwoWay}">
                                            <x:String>New selection</x:String><x:String>Add to selection</x:String><x:String>Subtract from selection</x:String><x:String>Intersect with selection</x:String>
                                        </ComboBox>
                                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.WandControlsVisibility, Mode=OneWay}">
                                            <NumberBox Header="Color tolerance (0–255)" AutomationProperties.Name="Magic wand tolerance" Minimum="0" Maximum="255"
                                                Value="{x:Bind ViewModel.WandTolerance, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                            <CheckBox Content="Contiguous pixels only" IsChecked="{x:Bind ViewModel.WandContiguous, Mode=TwoWay}"/>
                                            <TextBlock Text="Samples the visible image, including visible layers." FontSize="10" TextWrapping="Wrap" Foreground="{ThemeResource SnapMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.PixelSelectionActionsVisibility, Mode=OneWay}">
                                        <Button Content="Copy selection" Click="CopyButton_Click" HorizontalAlignment="Stretch"/>
                                        <Button Content="Fill selection…" Click="FillPixelSelection_Click" HorizontalAlignment="Stretch"/>
                                        <Button Content="Invert selection" Click="InvertPixelSelection_Click" HorizontalAlignment="Stretch"/>
                                        <Button Content="Deselect" Click="DeselectPixelSelection_Click" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <TextBlock Text="Only shared properties are shown. Select one object to edit its other properties."
                                        TextWrapping="Wrap" FontSize="10" Margin="0,4,0,8" Foreground="{ThemeResource SnapMutedBrush}"
                                        Visibility="{x:Bind ViewModel.AnnotationMultipleSelectionVisibility, Mode=OneWay}"/>
                                    <Grid ColumnSpacing="8" RowSpacing="2" Margin="0,2,0,6"
                                        Visibility="{x:Bind ViewModel.AnnotationShapeControlsVisibility, Mode=OneWay}">
