                                                            <controls:GridFamilyEditor Title="Bottom VP" Settings="{x:Bind ViewModel.BottomGridStyle, Mode=TwoWay}" Visibility="{x:Bind ViewModel.BottomGridFamilyVisibility, Mode=OneWay}"/>
