                                                                <ComboBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><controls:WorkspaceIcon Kind="Grid2" Width="20" Height="20"/><TextBlock Text="2-point perspective"/></StackPanel></ComboBoxItem>
                                                                <ComboBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><controls:WorkspaceIcon Kind="Grid3" Width="20" Height="20"/><TextBlock Text="3-point perspective"/></StackPanel></ComboBoxItem>
                                                                <ComboBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><controls:WorkspaceIcon Kind="Grid4" Width="20" Height="20"/><TextBlock Text="4-point curved"/></StackPanel></ComboBoxItem>
