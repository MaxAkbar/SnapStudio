                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    AccessKey="R"
                                                    AutomationProperties.HelpText="Rename the selected capture using the title field."
                                                    AutomationProperties.Name="Rename current capture"
                                                    Click="RenameCurrentDocumentButton_Click"
                                                    HorizontalAlignment="Stretch"
                                                    IsEnabled="{x:Bind ViewModel.CanRenameCurrentDocument, Mode=OneWay}"
                                                    Style="{StaticResource SidebarIconButtonStyle}"
                                                    ToolTipService.ToolTip="Rename">
                                                    <SymbolIcon Symbol="Edit"/>
                                                </Button>
                                                <Button
                                                    Grid.Column="1"
                                                    AccessKey="D"
                                                    AutomationProperties.HelpText="Duplicate the selected capture."
                                                    AutomationProperties.Name="Duplicate current capture"
                                                    Click="DuplicateCurrentDocumentButton_Click"
                                                    HorizontalAlignment="Stretch"
                                                    IsEnabled="{x:Bind ViewModel.CanDuplicateCurrentDocument, Mode=OneWay}"
                                                    Style="{StaticResource SidebarIconButtonStyle}"
                                                    ToolTipService.ToolTip="Duplicate">
                                                    <controls:WorkspaceIcon Kind="Copy" Width="16" Height="16"/>
                                                </Button>
                                                <Button
                                                    Grid.Column="2"
                                                    AccessKey="F"
                                                    AutomationProperties.HelpText="Open the selected capture's containing folder."
                                                    AutomationProperties.Name="Open current capture folder"
                                                    Click="OpenCurrentDocumentFolderButton_Click"
                                                    HorizontalAlignment="Stretch"
                                                    IsEnabled="{x:Bind ViewModel.CanOpenCurrentDocumentFolder, Mode=OneWay}"
                                                    Style="{StaticResource SidebarIconButtonStyle}"
                                                    ToolTipService.ToolTip="Open containing folder">
                                                    <controls:WorkspaceIcon Kind="Folder" Width="16" Height="16"/>
                                                </Button>
                                                <Button
                                                    Grid.Column="3"
                                                    AccessKey="X"
                                                    AutomationProperties.HelpText="Remove the selected capture from SnapStudio history while keeping the source image file."
                                                    AutomationProperties.Name="Remove current capture from history"
                                                    Click="DeleteCurrentDocumentButton_Click"
                                                    HorizontalAlignment="Stretch"
                                                    IsEnabled="{x:Bind ViewModel.CanDeleteCurrentDocument, Mode=OneWay}"
                                                    Style="{StaticResource SidebarIconButtonStyle}"
                                                    ToolTipService.ToolTip="Remove from history">
                                                    <SymbolIcon Symbol="Cancel"/>
                                                </Button>
                                                <Button
                                                    Grid.Column="4"
                                                    AccessKey="T"
                                                    AutomationProperties.HelpText="Move the selected capture's source image to the recycle bin and remove it from SnapStudio history."
                                                    AutomationProperties.Name="Move current capture to recycle bin"
                                                    Click="MoveCurrentCaptureToTrashButton_Click"
                                                    HorizontalAlignment="Stretch"
                                                    IsEnabled="{x:Bind ViewModel.CanMoveCurrentCaptureToTrash, Mode=OneWay}"
                                                    Style="{StaticResource SidebarIconButtonStyle}"
                                                    ToolTipService.ToolTip="Move to recycle bin">
                                                    <controls:WorkspaceIcon Kind="Trash" Width="16" Height="16"/>
                                                </Button>
                                            </Grid>
                                            <Button
                                                Content="Move to folder…"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="Move current capture to folder"
                                                Click="MoveCurrentCaptureToFolder_Click"
                                                IsEnabled="{x:Bind ViewModel.CanMoveCurrentCaptureToHistoryFolder, Mode=OneWay}" />
                                            <Button
                                                AccessKey="P"
                                                AutomationProperties.HelpText="Pin the current capture in a separate window."
                                                AutomationProperties.Name="Pin current capture"
                                                Click="PinButton_Click"
                                                IsEnabled="{x:Bind ViewModel.CanPinCurrentDocument, Mode=OneWay}"
                                                Style="{StaticResource TopCommandButtonStyle}"
                                                ToolTipService.ToolTip="Pin">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <controls:WorkspaceIcon Kind="PanelLeft" Width="16" Height="16"/>
                                                    <TextBlock Text="Pin"/>
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                AccessKey="S"
                                                AutomationProperties.HelpText="Open setup and application settings."
                                                AutomationProperties.Name="Settings"
                                                Click="SettingsButton_Click"
                                                Style="{StaticResource ToolIconButtonStyle}"
                                                ToolTipService.ToolTip="Settings">
                                                <controls:WorkspaceIcon Kind="Settings" Width="16" Height="16"/>
                                            </Button>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Padding="16,0,12,0"
                        Background="{StaticResource SnapSurfaceBrush}"
                        BorderBrush="{StaticResource SnapStrokeBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <controls:AnnotationToolIcon Kind="{x:Bind WorkspaceToolKind, Mode=OneWay}" Width="15" Height="15"/>
                            <TextBlock Text="{x:Bind ViewModel.ActiveAnnotationToolLabel, Mode=OneWay}" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind WorkspaceToolHint, Mode=OneWay}"
                            FontSize="10"
                            VerticalAlignment="Center"
                            Grid.Column="1"
                            Margin="16,0,8,0"
                            Foreground="#737E8E"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Grid.Column="2">
                            <Button
                                AccessKey="A"
                                AutomationProperties.AcceleratorKey="Ctrl+Enter"
                                AutomationProperties.HelpText="Add the selected annotation tool to the current capture."
                                AutomationProperties.Name="Add selected annotation tool"
                                Click="AddAnnotationButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanAddActiveAnnotation, Mode=OneWay}"
                                Style="{StaticResource SidebarIconButtonStyle}"
                                ToolTipService.ToolTip="Add selected tool">
                                <controls:WorkspaceIcon Kind="Plus" Width="16" Height="16"/>
                            </Button>
                            <Button
                                AccessKey="D"
                                AutomationProperties.AcceleratorKey="Ctrl+Delete"
                                AutomationProperties.HelpText="Delete the selected annotation."
                                AutomationProperties.Name="Delete selected annotation"
                                Click="DeleteAnnotationButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanDeleteSelectedAnnotation, Mode=OneWay}"
                                Style="{StaticResource SidebarIconButtonStyle}"
                                ToolTipService.ToolTip="Delete selected object (Delete)">
                                <controls:WorkspaceIcon Kind="Trash" Width="16" Height="16"/>
                            </Button>
                            <Button
                                AutomationProperties.AcceleratorKey="Ctrl+Z"
                                AutomationProperties.Name="{x:Bind ViewModel.UndoToolTip, Mode=OneWay}"
                                Click="UndoButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}"
                                Style="{StaticResource SidebarIconButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.UndoToolTip, Mode=OneWay}">
                                <controls:WorkspaceIcon Kind="Undo" Width="16" Height="16"/>
                            </Button>
                            <Button
                                AutomationProperties.AcceleratorKey="Ctrl+Y"
                                AutomationProperties.Name="{x:Bind ViewModel.RedoToolTip, Mode=OneWay}"
                                Click="RedoButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}"
                                Style="{StaticResource SidebarIconButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.RedoToolTip, Mode=OneWay}">
                                <controls:WorkspaceIcon Kind="Redo" Width="16" Height="16"/>
                            </Button>
                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Recording active indicator"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{x:Bind ViewModel.ScreenRecordingIndicatorVisibility, Mode=OneWay}">
                                <Ellipse Width="8" Height="8" Fill="#FFD13438"/>
                                <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{x:Bind ViewModel.ScreenRecordingIndicatorText, Mode=OneWay}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
            <controls:ResizeSplitter
                x:Name="RightControlsSplitter"
                Grid.Column="3"
                AutomationProperties.HelpText="Drag left or right to resize the right tools pane."
                AutomationProperties.Name="Resize right tools pane"
                PointerCanceled="RightControlsSplitter_PointerCanceled"
                PointerMoved="RightControlsSplitter_PointerMoved"
                PointerPressed="RightControlsSplitter_PointerPressed"
                PointerReleased="RightControlsSplitter_PointerReleased"
                ToolTipService.ToolTip="Drag to resize tools pane">
                <controls:ResizeSplitter.Template>
                    <ControlTemplate TargetType="controls:ResizeSplitter">
                        <Grid Background="{StaticResource SnapSurfaceBrush}">
                            <Border
                                Width="2"
                                Height="44"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource SnapStrokeBrush}"
                                CornerRadius="1" />
                        </Grid>
                    </ControlTemplate>
                </controls:ResizeSplitter.Template>
            </controls:ResizeSplitter>
            <Grid
                x:Name="RightControlsPane"
                Grid.Column="4"
                Background="{StaticResource SnapPanelBrush}"
                BorderBrush="{StaticResource SnapStrokeBrush}"
                BorderThickness="1,0,0,0">
                <Grid x:Name="RightControlsExpandedView" Padding="0" RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="39"/>
                    </Grid.RowDefinitions>
                    <Grid
                        Margin="0,0,12,14"
                        Height="54"
                        Padding="16,0"
                        BorderBrush="{StaticResource SnapStrokeBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="8" Orientation="Horizontal">
                            <controls:WorkspaceIcon Kind="Settings" Width="17" Height="17"/>
                            <TextBlock Text="Inspector" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            AutomationProperties.HelpText="Collapse the right-side tools pane."
                            AutomationProperties.Name="Unpin right tools pane"
                            Click="RightControlsPanePinButton_Click"
                            Style="{StaticResource ToolIconButtonStyle}"
                            ToolTipService.ToolTip="Unpin tools pane">
                            <controls:WorkspaceIcon Kind="PanelRight" Width="16" Height="16"/>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" RowSpacing="0" SizeChanged="InspectorBody_SizeChanged" x:Name="InspectorBodyGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="InspectorLayersRow" Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Expander
                            Header="Properties"
                            IsExpanded="True"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="16,0"
                            MinWidth="0"
                            Expanding="InspectorSection_Expanding"
                            AutomationProperties.Name="Properties"
                            x:Name="PropertiesSectionExpander" SizeChanged="InspectorSection_SizeChanged"
                            Style="{StaticResource WorkspaceExpanderStyle}">
                            <ScrollViewer
                                HorizontalScrollMode="Disabled"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Auto"
                                VerticalScrollBarVisibility="Auto"
                                MaxHeight="230"
                                Padding="17,0,17,17"
                                x:Name="PropertiesSectionExpanderScroll">
                                <StackPanel Spacing="4">
                                    <StackPanel Spacing="7" Margin="0,0,0,8">
                                        <TextBlock Text="Selected object / tool" FontSize="9" VerticalAlignment="Center" Foreground="#838E9E"/>
                                        <Border
                                            Height="31"
                                            Padding="9,0"
                                            Background="#272A31"
                                            BorderBrush="#3C414A"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                            <TextBlock
                                                Text="{x:Bind WorkspaceObjectLabel, Mode=OneWay}"
                                                FontSize="11"
                                                VerticalAlignment="Center"
                                                Foreground="#C5CEDA"
                                                TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </StackPanel>
                                    <Grid ColumnSpacing="8" MinHeight="38" Visibility="{x:Bind ViewModel.AnnotationColorControlsVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.AnnotationSizeHeader, Mode=OneWay}" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource SnapMutedBrush}"/>
                                        <Button
                                            AutomationProperties.HelpText="Open the custom annotation color picker."
                                            AutomationProperties.Name="Custom annotation color"
                                            ToolTipService.ToolTip="Custom color"
                                            Style="{StaticResource WorkspaceCommandButtonStyle}"
                                            Height="28"
                                            MinHeight="0"
                                            Padding="5,0"
                                            MinWidth="88"
                                            Grid.Column="1">
                                            <Button.Flyout>
                                                <Flyout>
                                                    <ColorPicker AutomationProperties.HelpText="Choose a custom annotation color." AutomationProperties.Name="Custom annotation color picker" ColorChanged="AnnotationCustomColor_ColorChanged" IsAlphaEnabled="False"/>
                                                </Flyout>
                                            </Button.Flyout>
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Border Width="16" Height="16" CornerRadius="3" Background="{x:Bind WorkspaceStrokeBrush, Mode=OneWay}"/>
                                                <TextBlock Text="{x:Bind WorkspaceColorHex, Mode=OneWay}" FontSize="9" VerticalAlignment="Center" CharacterSpacing="30"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Grid.Column="2">
                                            <TextBox
                                                AutomationProperties.HelpText="Enter a stroke width in pixels or a text size. Valid numbers apply immediately; both can exceed the slider range."
                                                AutomationProperties.Name="Annotation size value"
                                                InputScope="Number"
                                                Text="{x:Bind ViewModel.AnnotationSizeText, Mode=OneWay}"
                                                TextChanged="AnnotationSizeText_TextChanged"
                                                LostFocus="AnnotationSizeText_LostFocus"
                                                Width="40"
                                                MinWidth="0"
                                                MinHeight="26"
                                                Height="26"
                                                Padding="5,0"
                                                FontSize="10" />
                                            <TextBlock Text="px" FontSize="9" VerticalAlignment="Center" Foreground="#7C8797"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel
                                        AutomationProperties.HelpText="Choose the annotation stroke color."
                                        AutomationProperties.Name="Annotation color"
                                        Orientation="Horizontal"
                                        Spacing="9"
                                        HorizontalAlignment="Right"
                                        Margin="0,5,0,7">
                                        <Button
                                            Background="#4CC2FF"
                                            Click="AnnotationStrokeButton_Click"
                                            Style="{StaticResource SwatchButtonStyle}"
                                            Tag="0"
                                            ToolTipService.ToolTip="Sky blue"
                                            Width="17"
                                            Height="17"
                                            MinWidth="17"
                                            MinHeight="17"
                                            CornerRadius="9" />
                                        <Button
                                            Background="#FFFFFF"
                                            Click="AnnotationStrokeButton_Click"
                                            Style="{StaticResource SwatchButtonStyle}"
                                            Tag="1"
                                            ToolTipService.ToolTip="White"
                                            Width="17"
                                            Height="17"
                                            MinWidth="17"
                                            MinHeight="17"
                                            CornerRadius="9" />
                                        <Button
                                            Background="#FFB85C"
                                            Click="AnnotationStrokeButton_Click"
                                            Style="{StaticResource SwatchButtonStyle}"
                                            Tag="2"
                                            ToolTipService.ToolTip="Amber"
                                            Width="17"
                                            Height="17"
                                            MinWidth="17"
                                            MinHeight="17"
                                            CornerRadius="9" />
                                        <Button
                                            Background="#FF747D"
                                            Click="AnnotationStrokeButton_Click"
                                            Style="{StaticResource SwatchButtonStyle}"
                                            Tag="3"
                                            ToolTipService.ToolTip="Coral"
                                            Width="17"
                                            Height="17"
                                            MinWidth="17"
                                            MinHeight="17"
                                            CornerRadius="9" />
                                        <Button
                                            Background="#94DCB1"
                                            Click="AnnotationStrokeButton_Click"
                                            Style="{StaticResource SwatchButtonStyle}"
                                            Tag="4"
                                            ToolTipService.ToolTip="Mint"
                                            Width="17"
                                            Height="17"
                                            MinWidth="17"
                                            MinHeight="17"
                                            CornerRadius="9" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="8" MinHeight="38" Visibility="{x:Bind ViewModel.AnnotationColorControlsVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Fill" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource SnapMutedBrush}"/>
                                        <Button
                                            Style="{StaticResource WorkspaceCommandButtonStyle}"
                                            Click="WorkspaceFill_Click"
                                            ToolTipService.ToolTip="Use the fill bucket to color a shape or image area"
                                            Height="27"
                                            Padding="8,0"
                                            FontSize="9"
                                            Grid.Column="1">
                                            <TextBlock Text="Fill bucket" FontSize="9" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                    <Grid ColumnSpacing="8" MinHeight="38">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Opacity" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource SnapMutedBrush}"/>
                                        <Slider
                                            AutomationProperties.HelpText="Set annotation opacity."
                                            AutomationProperties.Name="Annotation opacity"
                                            Maximum="1"
                                            Minimum="0.1"
                                            StepFrequency="0.05"
                                            Value="{x:Bind ViewModel.AnnotationOpacity, Mode=OneWay}"
                                            ValueChanged="AnnotationOpacity_ValueChanged"
                                            Width="100"
                                            Height="28"
                                            MinHeight="0"
                                            Grid.Column="1" />
                                        <TextBlock
                                            Text="{x:Bind WorkspaceOpacityLabel, Mode=OneWay}"
                                            FontSize="10"
                                            VerticalAlignment="Center"
                                            MinWidth="32"
                                            TextAlignment="Right"
                                            Grid.Column="2" />
                                    </Grid>
                                    <Grid ColumnSpacing="8" MinHeight="38" Visibility="{x:Bind ViewModel.AnnotationCornerStyleControlsVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Corner style" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource SnapMutedBrush}"/>
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                Grid.Column="0"
                                                Click="WorkspaceCorners_Click"
                                                Tag="0"
                                                Style="{StaticResource WorkspaceIconButtonStyle}"
                                                Width="32"
                                                Height="26"
                                                Background="{x:Bind WorkspaceSquareCornersBrush, Mode=OneWay}"
                                                AutomationProperties.Name="Square corners"
                                                ToolTipService.ToolTip="Square corners">
                                                <Rectangle
                                                    Width="13"
                                                    Height="10"
                                                    RadiusX="0"
                                                    RadiusY="0"
                                                    Stroke="#B8D8ED"
                                                    StrokeThickness="1.5" />
                                            </Button>
                                            <Button
                                                Grid.Column="1"
                                                Click="WorkspaceCorners_Click"
                                                Tag="1"
                                                Style="{StaticResource WorkspaceIconButtonStyle}"
                                                Width="32"
                                                Height="26"
                                                Background="{x:Bind WorkspaceRoundedCornersBrush, Mode=OneWay}"
                                                AutomationProperties.Name="Round corners"
                                                ToolTipService.ToolTip="Round corners">
                                                <Rectangle
                                                    Width="13"
                                                    Height="10"
                                                    RadiusX="3"
                                                    RadiusY="3"
                                                    Stroke="#B8D8ED"
                                                    StrokeThickness="1.5" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                    <ComboBox
                                        Header="Font"
                                        AutomationProperties.Name="Text font"
                                        AutomationProperties.HelpText="Choose a font installed on this computer. Applies to selected text objects or new text."
                                        ItemsSource="{x:Bind ViewModel.AnnotationFontFamilies, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.AnnotationFontFamily, Mode=OneWay}"
                                        IsTextSearchEnabled="True"
                                        SelectionChanged="AnnotationFontFamily_SelectionChanged"
                                        Visibility="{x:Bind ViewModel.AnnotationFontControlsVisibility, Mode=OneWay}"
                                        Margin="0,6,0,4" />
                                    <Slider
                                        AutomationProperties.Name="Fill tolerance"
                                        AutomationProperties.HelpText="For image areas, higher tolerance fills a wider range of similar colors. Zero fills only matching colors. Shape fills do not use tolerance."
                                        Header="Fill tolerance"
                                        Minimum="0"
                                        Maximum="255"
                                        StepFrequency="1"
                                        Value="{x:Bind ViewModel.FillTolerance, Mode=TwoWay}"
                                        Visibility="{x:Bind ViewModel.FillToleranceControlsVisibility, Mode=OneWay}" />
                                    <TextBox
                                        AutomationProperties.HelpText="Edit the selected text annotation."
                                        Visibility="{x:Bind ViewModel.AnnotationFontControlsVisibility, Mode=OneWay}"
                                        AutomationProperties.Name="Annotation text"
                                        Header="Text"
                                        LostFocus="AnnotationText_LostFocus"
                                        IsEnabled="{x:Bind ViewModel.CanEditAnnotationText, Mode=OneWay}"
                                        Text="{x:Bind ViewModel.AnnotationText, Mode=OneWay}" />
                                    <Expander
                                        Header="More tool options"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="0"
                                        IsExpanded="False"
                                        Style="{StaticResource WorkspaceExpanderStyle}"
                                        FontSize="9">
                                        <StackPanel Spacing="10">
                                            <Slider
                                                AutomationProperties.HelpText="Set annotation stroke thickness or text size."
                                                AutomationProperties.Name="Annotation size"
                                                Header="{x:Bind ViewModel.AnnotationSizeHeader, Mode=OneWay}"
                                                Maximum="{x:Bind ViewModel.AnnotationSizeMaximum, Mode=OneWay}"
                                                Minimum="1"
                                                StepFrequency="{x:Bind ViewModel.AnnotationSizeStepFrequency, Mode=OneWay}"
                                                Value="{x:Bind ViewModel.AnnotationSizeSliderValue, Mode=OneWay}"
                                                ValueChanged="AnnotationStrokeSize_ValueChanged" />
                                            <ComboBox
                                                AutomationProperties.HelpText="Choose whether rectangle annotations use sharp or rounded corners."
                                                AutomationProperties.Name="Rectangle corner style"
                                                Header="Corners"
                                                SelectedIndex="{x:Bind ViewModel.AnnotationCornerStyleIndex, Mode=OneWay}"
                                                SelectionChanged="AnnotationCornerStyle_SelectionChanged"
                                                Visibility="{x:Bind ViewModel.AnnotationCornerStyleControlsVisibility, Mode=OneWay}">
                                                <ComboBoxItem Content="Edges"/>
                                                <ComboBoxItem Content="Rounded"/>
                                            </ComboBox>
                                            <ComboBox
                                                AutomationProperties.HelpText="Choose a common annotation preset for new annotations."
                                                AutomationProperties.Name="Annotation preset"
                                                Header="Preset"
                                                SelectedIndex="{x:Bind ViewModel.AnnotationPresetIndex, Mode=OneWay}"
                                                SelectionChanged="AnnotationPreset_SelectionChanged">
                                                <ComboBoxItem Content="Custom"/>
                                                <ComboBoxItem Content="Standard box"/>
                                                <ComboBoxItem Content="Emphasis box"/>
                                                <ComboBoxItem Content="Pointer arrow"/>
                                                <ComboBoxItem Content="Text label"/>
                                                <ComboBoxItem Content="Highlighter"/>
                                                <ComboBoxItem Content="Blur region"/>
                                            </ComboBox>
                                            <ComboBox
                                                AutomationProperties.HelpText="Choose the annotation tool used for new annotations."
                                                AutomationProperties.Name="Annotation tool"
                                                Header="Tool"
                                                SelectedIndex="{x:Bind ViewModel.AnnotationToolSelectionIndex, Mode=OneWay}"
                                                SelectionChanged="AnnotationTool_SelectionChanged">
