                                        Style="{StaticResource SidebarSectionHeaderButtonStyle}"
                                        FontSize="11">
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Layers" Style="{StaticResource SidebarSectionHeadingStyle}" VerticalAlignment="Center"/>
