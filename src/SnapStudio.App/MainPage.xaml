                            <RowDefinition x:Name="InspectorLayersRow" Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Expander
                            Header="Properties"
                            IsExpanded="True"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="16,0"
                            MinWidth="0"
                            Expanding="InspectorSection_Expanding"
                            AutomationProperties.Name="Properties"
                            x:Name="PropertiesSectionExpander" SizeChanged="InspectorSection_SizeChanged"
                            Style="{StaticResource WorkspaceExpanderStyle}">
                            <ScrollViewer
                                HorizontalScrollMode="Disabled"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Auto"
                                VerticalScrollBarVisibility="Auto"
                                MaxHeight="230"
                                Padding="17,0,17,17"
                                x:Name="PropertiesSectionExpanderScroll">
                                <StackPanel Spacing="4">
                                    <StackPanel Spacing="7" Margin="0,0,0,8">
                                        <TextBlock Text="Selected object / tool" FontSize="9" VerticalAlignment="Center" Foreground="{ThemeResource WorkspaceMutedBrush}"/>
                                        <Border
                                            Height="31"
                                            Padding="9,0"
                                            Background="{ThemeResource WorkspaceFieldBrush}"
                                            BorderBrush="{ThemeResource WorkspaceFieldBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                            <TextBlock
                                                Text="{x:Bind WorkspaceObjectLabel, Mode=OneWay}"
                                                FontSize="11"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource WorkspaceSecondaryTextBrush}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.AnnotationSelectionDescription, Mode=OneWay}"
                                        TextWrapping="Wrap" FontSize="11" Margin="0,4,0,8" Foreground="{ThemeResource SnapMutedBrush}"
