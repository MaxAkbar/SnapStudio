                                                                    </StackPanel>
                                                                    <StackPanel Width="142">
                                                                        <NumberBox Header="Right VP X (%)" AutomationProperties.Name="Right vanishing point X percent" Minimum="-500" Maximum="500" Value="{x:Bind ViewModel.PerspectiveRight, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                                                        <Slider AutomationProperties.Name="Right vanishing point X slider" Minimum="-500" Maximum="500" StepFrequency="1" Value="{x:Bind ViewModel.PerspectiveRight, Mode=TwoWay}"/>
                                                                    </StackPanel>
                                                                </StackPanel>
