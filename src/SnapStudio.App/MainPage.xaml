<?xml version="1.0" encoding="utf-8" ?>
<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SnapStudio.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:items="using:SnapStudio.App.ViewModels.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="SnapStudio.App.MainPage"
    AutomationProperties.Name="SnapStudio workspace"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    RequestedTheme="Dark"
    mc:Ignorable="d"
    FontFamily="Segoe UI"
    FontSize="12"
    Foreground="#EEF0F4">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Controls/WorkspaceStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="SnapBackgroundBrush" Color="#17191E"/>
            <SolidColorBrush x:Key="SnapSurfaceBrush" Color="#1E2026"/>
            <SolidColorBrush x:Key="SnapPanelBrush" Color="#202228"/>
            <SolidColorBrush x:Key="SnapPanelAltBrush" Color="#282B32"/>
            <SolidColorBrush x:Key="SnapStrokeBrush" Color="#34373F"/>
            <SolidColorBrush x:Key="SnapMutedBrush" Color="#969BA8"/>
            <SolidColorBrush x:Key="SnapAccentBrush" Color="#88D2FA"/>
            <SolidColorBrush x:Key="SnapAccentMutedBrush" Color="#293E4C"/>
            <SolidColorBrush x:Key="SnapPrimaryBrush" Color="#0879D0"/>
            <SolidColorBrush x:Key="SidebarSectionStrokeBrush" Color="#34373F"/>
            <Style x:Key="SidebarSectionBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SnapPanelBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SidebarSectionStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
            <Style x:Key="SidebarSectionHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#E3EBF5"/>
            </Style>
            <Style x:Key="TopCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource WorkspaceCommandButtonStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#C5C9D2"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="SidebarSectionHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource WorkspaceIconButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#D8DEE7"/>
            </Style>
            <Style x:Key="PrimaryTopCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource WorkspaceCommandButtonStyle}">
                <Setter Property="Background" Value="#313741"/>
                <Setter Property="BorderBrush" Value="#475361"/>
                <Setter Property="Foreground" Value="#F2F5F9"/>
            </Style>
            <Style x:Key="ExportTopCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource WorkspacePrimaryButtonStyle}"/>
            <Style x:Key="ToolIconButtonStyle" TargetType="Button" BasedOn="{StaticResource WorkspaceIconButtonStyle}"/>
            <Style x:Key="SidebarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource WorkspaceIconButtonStyle}">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
            </Style>
            <Style x:Key="EditorToolButtonStyle" TargetType="Button" BasedOn="{StaticResource WorkspaceIconButtonStyle}">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="MinWidth" Value="36"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="CornerRadius" Value="6"/>
            </Style>
            <Style x:Key="SwatchButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="MinWidth" Value="24"/>
                <Setter Property="MinHeight" Value="24"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderBrush" Value="{StaticResource SnapStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
            </Style>
            <Style x:Key="LayerRowButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="LayerRowIconButtonStyle" TargetType="Button" BasedOn="{StaticResource LayerRowButtonStyle}">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource WorkspaceTextBoxStyle}"/>
            <Style TargetType="ComboBox" BasedOn="{StaticResource WorkspaceComboBoxStyle}"/>
            <SolidColorBrush Color="#475363" x:Key="SliderTrackFill"/>
            <SolidColorBrush Color="#88D2FA" x:Key="SliderTrackValueFill"/>
            <SolidColorBrush Color="#88D2FA" x:Key="SliderThumbBackground"/>
            <SolidColorBrush Color="#B2E2FF" x:Key="SliderThumbBackgroundPointerOver"/>
            <SolidColorBrush Color="#88D2FA" x:Key="SliderThumbBackgroundPressed"/>
            <SolidColorBrush Color="#88D2FA" x:Key="SliderTrackValueFillPointerOver"/>
            <Style x:Key="WorkspaceCaptureItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="MinHeight" Value="69"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RowFrame.Background" Value="#2A2D35"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RowFrame.Background" Value="#303B49"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="RowFrame.Background" Value="#2B3541"/>
                                                <Setter Target="RowFrame.BorderBrush" Value="#4B6377"/>
                                                <Setter Target="SelectionIndicator.Visibility" Value="Visible"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="RowFrame.Background" Value="#303D4C"/>
                                                <Setter Target="RowFrame.BorderBrush" Value="#5E7C96"/>
                                                <Setter Target="SelectionIndicator.Visibility" Value="Visible"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="RowFrame.Background" Value="#334453"/>
                                                <Setter Target="RowFrame.BorderBrush" Value="#5E7C96"/>
                                                <Setter Target="SelectionIndicator.Visibility" Value="Visible"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RowFrame.Opacity" Value="0.4"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    x:Name="RowFrame"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <ContentPresenter
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Center" />
                                </Border>
                                <Border
                                    x:Name="SelectionIndicator"
                                    Visibility="Collapsed"
                                    Width="2"
                                    CornerRadius="2"
                                    Background="#8BCEFA"
                                    HorizontalAlignment="Left"
                                    Margin="0,12" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewImageKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteImageKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="V" Modifiers="Control,Shift" Invoked="PasteImageKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="CaptureRegionKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="C" Modifiers="Control,Shift" Invoked="CopyKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="UndoKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="RedoKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="FitCanvasKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="ActualSizeKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Add" Modifiers="Control" Invoked="ZoomInKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Subtract" Modifiers="Control" Invoked="ZoomOutKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="AddAnnotationKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Delete" Modifiers="Control" Invoked="DeleteAnnotationKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Delete" Invoked="ObjectActionKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="D" Modifiers="Control" Invoked="ObjectActionKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectAllObjectsKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="H" Modifiers="Control" Invoked="ObjectActionKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Escape" Invoked="ClearObjectSelectionKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="PageUp" Modifiers="Control" Invoked="ObjectActionKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="PageDown" Modifiers="Control" Invoked="ObjectActionKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="PageUp" Modifiers="Control,Shift" Invoked="ObjectActionKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="PageDown" Modifiers="Control,Shift" Invoked="ObjectActionKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="F8" Invoked="FocusWorkspaceKeyboardAccelerator_Invoked"/>
    </Page.KeyboardAccelerators>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            Padding="20,0"
            Background="{StaticResource SnapPanelBrush}"
            BorderBrush="{StaticResource SnapStrokeBrush}"
            BorderThickness="0,0,0,1"
            Height="64">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Image Source="Assets/Square44x44Logo.scale-200.png" Width="28" Height="28"/>
                    <TextBlock Text="SnapStudio" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button
                    AccessKey="C"
                    AutomationProperties.AcceleratorKey="Ctrl+R"
                    AutomationProperties.HelpText="Open capture mode menu. Press Ctrl+R to start a region capture."
                    AutomationProperties.Name="Capture"
                    Style="{StaticResource PrimaryTopCommandButtonStyle}"
                    Grid.Column="1">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                AccessKey="R"
                                AutomationProperties.AcceleratorKey="Ctrl+R"
                                AutomationProperties.HelpText="Capture a selected screen region."
                                AutomationProperties.Name="Capture region"
                                Click="CaptureRegionButton_Click"
                                Text="Region">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="Crop"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                AccessKey="P"
                                AutomationProperties.HelpText="Choose a window or display to capture."
                                AutomationProperties.Name="Capture with picker"
                                Click="CapturePickerButton_Click"
                                Text="Picker">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="Camera"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                AccessKey="D"
                                AutomationProperties.HelpText="Choose which connected display to capture."
                                AutomationProperties.Name="Capture display"
                                Click="CaptureDisplayButton_Click"
                                Text="Display">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="View"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                AccessKey="F"
                                AutomationProperties.HelpText="Capture all connected displays together in one image."
                                AutomationProperties.Name="Capture full screen"
                                Click="CaptureFullScreenButton_Click"
                                Text="Full Screen (all displays)">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="FullScreen"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                AccessKey="W"
                                AutomationProperties.HelpText="Choose an open window by title or app name."
                                AutomationProperties.Name="Capture window"
                                Click="CaptureWindowButton_Click"
                                Text="Window">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="Switch"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                AccessKey="S"
                                AutomationProperties.HelpText="Capture the first detected scrollable target and preserve partial output when scrolling cannot complete."
                                AutomationProperties.Name="Capture scrolling target"
                                Click="CaptureScrollingButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanCaptureScrolling, Mode=OneWay}"
                                Text="Scrolling"
                                Visibility="{x:Bind ViewModel.ScrollingCaptureControlsVisibility, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="View"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem
                                AccessKey="V"
                                AutomationProperties.HelpText="Start or stop recording a selected window or display."
                                AutomationProperties.Name="{x:Bind ViewModel.ScreenRecordingAutomationName, Mode=OneWay}"
                                Click="ToggleScreenRecordingButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanToggleScreenRecording, Mode=OneWay}"
                                Text="{x:Bind ViewModel.ScreenRecordingCommandText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ScreenRecordingControlsVisibility, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="Camera"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:WorkspaceIcon Kind="Camera" Width="16" Height="16"/>
                        <TextBlock FontWeight="SemiBold" Text="New capture" FontSize="12"/>
                        <FontIcon FontSize="12" Glyph=""/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button
                        AccessKey="N"
                        AutomationProperties.AcceleratorKey="Ctrl+N"
                        AutomationProperties.HelpText="Create a new image with a transparent background."
                        AutomationProperties.Name="New image"
                        Click="NewImageButton_Click"
                        IsEnabled="{x:Bind ViewModel.CanCreateImage, Mode=OneWay}"
                        Style="{StaticResource TopCommandButtonStyle}"
                        ToolTipService.ToolTip="New image (Ctrl+N)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:WorkspaceIcon Kind="Plus" Width="16" Height="16"/>
                            <TextBlock Text="New" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button
                        AccessKey="O"
                        AutomationProperties.AcceleratorKey="Ctrl+O"
                        AutomationProperties.HelpText="Open an image file into the workspace."
                        AutomationProperties.Name="Open image"
                        Click="OpenButton_Click"
                        IsEnabled="{x:Bind ViewModel.CanOpenImageFile, Mode=OneWay}"
                        Style="{StaticResource TopCommandButtonStyle}"
                        ToolTipService.ToolTip="Open (Ctrl+O)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:WorkspaceIcon Kind="Folder" Width="16" Height="16"/>
                            <TextBlock Text="Open" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            AccessKey="V"
                            AutomationProperties.AcceleratorKey="Ctrl+V"
                            AutomationProperties.HelpText="Choose whether to paste the clipboard image as a new layer or a new image."
                            AutomationProperties.Name="Paste image"
                            Click="PasteImageButton_Click"
                            IsEnabled="{x:Bind ViewModel.CanCreateImage, Mode=OneWay}"
                            Style="{StaticResource TopCommandButtonStyle}"
                            ToolTipService.ToolTip="Paste image (Ctrl+V)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:WorkspaceIcon Kind="Paste" Width="16" Height="16"/>
                                <TextBlock Text="Paste" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="Paste options"
                            AutomationProperties.HelpText="Choose whether to paste an image as a new layer or a new image."
                            IsEnabled="{x:Bind ViewModel.CanCreateImage, Mode=OneWay}"
                            Style="{StaticResource TopCommandButtonStyle}"
                            Padding="4,0"
                            ToolTipService.ToolTip="Paste options">
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="Paste as new layer" IsEnabled="{x:Bind ViewModel.CanPasteImageAsLayer, Mode=OneWay}" Click="PasteImageAsLayer_Click"/>
                                    <MenuFlyoutItem Text="Paste as new image" KeyboardAcceleratorTextOverride="Ctrl+Shift+V" Click="PasteImageAsNewDocument_Click"/>
                                </MenuFlyout>
                            </Button.Flyout>
                            <FontIcon Glyph="" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <Button
                    Grid.Column="5"
                    AccessKey="Y"
                    AutomationProperties.AcceleratorKey="Ctrl+C"
                    AutomationProperties.HelpText="Copy the selected area, or the whole edited image when nothing is selected."
                    AutomationProperties.Name="Copy current capture"
                    Click="CopyButton_Click"
                    Style="{StaticResource TopCommandButtonStyle}"
                    ToolTipService.ToolTip="Copy selection or image (Ctrl+C)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:WorkspaceIcon Kind="Copy" Width="16" Height="16"/>
                        <TextBlock Text="Copy" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="6"
                    AccessKey="E"
                    AutomationProperties.HelpText="Open export format options."
                    AutomationProperties.Name="Export"
                    Style="{StaticResource ExportTopCommandButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                AccessKey="P"
                                AutomationProperties.HelpText="Export the current capture as a PNG image."
                                AutomationProperties.Name="Export PNG"
                                Click="ExportPngButton_Click"
                                Text="PNG">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="Save"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                AccessKey="J"
                                AutomationProperties.HelpText="Export the current capture as a JPEG image."
                                AutomationProperties.Name="Export JPEG"
                                Click="ExportJpegButton_Click"
                                Text="JPEG">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="Pictures"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                AccessKey="D"
                                AutomationProperties.HelpText="Export the current capture as a PDF document."
                                AutomationProperties.Name="Export PDF"
                                Click="ExportPdfButton_Click"
                                Text="PDF">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="Document"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:WorkspaceIcon Kind="Export" Width="16" Height="16"/>
                        <TextBlock FontWeight="SemiBold" Text="Export" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button
                    Click="FocusWorkspace_Click"
                    AutomationProperties.Name="Focus mode"
                    ToolTipService.ToolTip="Focus mode (F8)"
                    Style="{StaticResource WorkspaceIconButtonStyle}"
                    x:Name="FocusWorkspaceButton"
                    Grid.Column="4">
                    <controls:WorkspaceIcon Kind="Focus" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>
        <Grid x:Name="MainContentGrid" Grid.Row="1" Background="{StaticResource SnapBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HistoryColumn" Width="268" MinWidth="52"/>
                    <ColumnDefinition x:Name="HistorySplitterColumn" Width="4"/>
                <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="RightControlsSplitterColumn" Width="4"/>
                <ColumnDefinition x:Name="RightControlsColumn" Width="272" MinWidth="52"/>
            </Grid.ColumnDefinitions>
            <Grid
                x:Name="HistoryPane"
                Grid.Column="0"
                Background="{StaticResource SnapPanelBrush}"
                BorderBrush="{StaticResource SnapStrokeBrush}"
                BorderThickness="0,0,1,0">
                <Grid x:Name="HistoryExpandedView" Padding="0" RowSpacing="0" SizeChanged="HistoryExpandedView_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="SidebarControlsRow" Height="Auto"/>
                        <RowDefinition x:Name="SidebarImagesRow" Height="*" MinHeight="180"/>
                        <RowDefinition x:Name="SidebarSettingsRow" Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer
                        x:Name="SidebarControlsScroll"
                        MaxHeight="480"
                        AutomationProperties.Name="Capture library controls"
                        HorizontalScrollMode="Disabled"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="0">
                            <Grid Height="54" ColumnSpacing="8" Margin="0" Padding="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="RecentCapturesSectionButton"
                                    Click="ToggleRecentCapturesSection_Click"
                                    AutomationProperties.Name="Collapse Recent captures section"
                                    Style="{StaticResource SidebarSectionHeaderButtonStyle}"
                                    Height="42"
                                    MinHeight="0"
                                    Padding="2,0">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <controls:WorkspaceIcon Kind="Library" Width="17" Height="17"/>
                                        <TextBlock
                                            Text="Library"
                                            FontSize="12"
                                            VerticalAlignment="Center"
                                            Grid.Column="1"
                                            FontWeight="SemiBold" />
                                        <FontIcon
                                            x:Name="RecentCapturesSectionChevron"
                                            Grid.Column="2"
                                            Glyph=""
                                            FontSize="10"
                                            Opacity="0.6" />
                                    </Grid>
                                </Button>
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.HelpText="Collapse the layers and recent captures pane."
                                    AutomationProperties.Name="Unpin layers and captures pane"
                                    Click="HistoryPanePinButton_Click"
                                    Style="{StaticResource SidebarIconButtonStyle}"
                                    ToolTipService.ToolTip="Unpin layers and captures pane">
                                    <controls:WorkspaceIcon Kind="PanelLeft" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                            <Border Padding="0" Style="{StaticResource SidebarSectionBorderStyle}" AutomationProperties.Name="Recent captures section" BorderThickness="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel x:Name="RecentCapturesSectionContent" Grid.Row="0" Spacing="9" Margin="12,12,12,8">
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox
                                                MinWidth="0"
                                                Height="34"
                                                MinHeight="34"
                                                Padding="7,0,22,0"
                                                FontSize="10"
                                                HorizontalAlignment="Stretch"
