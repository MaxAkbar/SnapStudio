                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="9" Foreground="#7B8799" Text="{x:Bind ViewModel.StatusText}" TextTrimming="CharacterEllipsis"/>
            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Right"
                FontSize="9"
                Foreground="#7B8799"
                Text="Only on your device"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind ViewModel.CurrentDocumentFooterLabel, Mode=OneWay}" />
        </Grid>
        <Grid
            Grid.RowSpan="3"
            Padding="24"
            Background="#D9000000"
            Canvas.ZIndex="10"
            Visibility="{x:Bind ViewModel.FirstRunSetupVisibility, Mode=OneWay}">
            <Border
                MaxWidth="840"
                MaxHeight="760"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Padding="24,20,20,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="{x:Bind ViewModel.SettingsPanelTitle, Mode=OneWay}"/>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Feature changes apply after restart."/>
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            AutomationProperties.Name="Close settings"
                            Click="CloseSettingsButton_Click"
                            Style="{StaticResource ToolIconButtonStyle}"
                            ToolTipService.ToolTip="Close settings"
                            Visibility="{x:Bind ViewModel.SettingsCloseButtonVisibility, Mode=OneWay}">
                            <SymbolIcon Symbol="Cancel"/>
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" Padding="24,4,24,20" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
                        <StackPanel Spacing="24">
                            <Grid ColumnSpacing="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="12">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Capture"/>
                                    <ComboBox
                                        AutomationProperties.HelpText="Choose the global capture hotkey."
                                        AutomationProperties.Name="Settings capture hotkey"
                                        Header="Capture hotkey"
                                        SelectedIndex="{x:Bind ViewModel.FirstRunCaptureHotkeyIndex, Mode=OneWay}"
                                        SelectionChanged="FirstRunHotkey_SelectionChanged">
                                        <ComboBoxItem Content="PrintScreen"/>
                                        <ComboBoxItem Content="Ctrl+Shift+S"/>
                                        <ComboBoxItem Content="Ctrl+Alt+S"/>
                                    </ComboBox>
                                    <ToggleSwitch AutomationProperties.HelpText="Include the mouse cursor in captures by default." AutomationProperties.Name="Settings include cursor" Header="Include cursor by default" IsOn="{x:Bind ViewModel.FirstRunIncludeCursor, Mode=TwoWay}"/>
                                    <ToggleSwitch AutomationProperties.HelpText="Copy new captures to the clipboard automatically." AutomationProperties.Name="Settings copy captures to clipboard" Header="Copy captures to clipboard" IsOn="{x:Bind ViewModel.FirstRunCopyCapturesToClipboard, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="12">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Storage"/>
                                    <ComboBox
                                        AutomationProperties.HelpText="Choose whether editable document data is stored in folders or a local CSharpDB database."
                                        AutomationProperties.Name="Settings storage backend"
                                        Header="Storage backend"
                                        SelectedIndex="{x:Bind ViewModel.FirstRunStorageBackendIndex, Mode=OneWay}"
                                        SelectionChanged="FirstRunStorageBackend_SelectionChanged">
                                        <ComboBoxItem Content="File system"/>
                                        <ComboBoxItem Content="Database"/>
                                    </ComboBox>
                                    <TextBox
                                        AutomationProperties.HelpText="Current storage location for local captures."
                                        AutomationProperties.Name="Settings storage location"
                                        Header="Storage location"
                                        IsReadOnly="True"
                                        Text="{x:Bind ViewModel.FirstRunStorageRoot, Mode=OneWay}" />
                                    <Button
                                        AccessKey="C"
                                        AutomationProperties.HelpText="Choose the local storage location for captures."
                                        AutomationProperties.Name="Choose storage location"
                                        Click="ChooseFirstRunStorageRootButton_Click"
                                        HorizontalAlignment="Left"
                                        IsEnabled="{x:Bind ViewModel.CanChooseFirstRunStorageRoot, Mode=OneWay}"
                                        ToolTipService.ToolTip="Choose storage location">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:WorkspaceIcon Kind="Folder" Width="16" Height="16"/>
                                            <TextBlock Text="Choose"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="12">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Features"/>
                                <Grid ColumnSpacing="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="8">
                                        <ToggleSwitch AutomationProperties.HelpText="Enable still capture commands." AutomationProperties.Name="Enable still capture" Header="Still capture" IsOn="{x:Bind ViewModel.SettingsStillCaptureEnabled, Mode=TwoWay}"/>
                                        <ToggleSwitch AutomationProperties.HelpText="Enable delayed capture support." AutomationProperties.Name="Enable delayed capture" Header="Delayed capture" IsOn="{x:Bind ViewModel.SettingsDelayedCaptureEnabled, Mode=TwoWay}"/>
                                        <ToggleSwitch AutomationProperties.HelpText="Enable cursor capture support." AutomationProperties.Name="Enable cursor capture" Header="Cursor capture" IsOn="{x:Bind ViewModel.SettingsCursorCaptureEnabled, Mode=TwoWay}"/>
                                        <ToggleSwitch AutomationProperties.HelpText="Enable GDI fallback capture support." AutomationProperties.Name="Enable GDI fallback" Header="GDI fallback" IsOn="{x:Bind ViewModel.SettingsGdiFallbackEnabled, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <ToggleSwitch AutomationProperties.HelpText="Enable the blur annotation tool." AutomationProperties.Name="Enable blur tool" Header="Blur tool" IsOn="{x:Bind ViewModel.SettingsBlurToolEnabled, Mode=TwoWay}"/>
                                        <ToggleSwitch AutomationProperties.HelpText="Enable PDF export." AutomationProperties.Name="Enable PDF export" Header="PDF export" IsOn="{x:Bind ViewModel.SettingsPdfExportEnabled, Mode=TwoWay}"/>
                                        <ToggleSwitch AutomationProperties.HelpText="Enable pinned images." AutomationProperties.Name="Enable pin to screen" Header="Pin to screen" IsOn="{x:Bind ViewModel.SettingsPinToScreenEnabled, Mode=TwoWay}"/>
                                        <ToggleSwitch AutomationProperties.HelpText="Enable OCR text extraction." AutomationProperties.Name="Enable OCR" Header="OCR" IsOn="{x:Bind ViewModel.SettingsOcrEnabled, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="8">
                                        <ToggleSwitch AutomationProperties.HelpText="Enable scrolling capture." AutomationProperties.Name="Enable scrolling capture" Header="Scrolling capture" IsOn="{x:Bind ViewModel.SettingsScrollingCaptureEnabled, Mode=TwoWay}"/>
                                        <ToggleSwitch AutomationProperties.HelpText="Enable screen recording." AutomationProperties.Name="Enable screen recording" Header="Screen recording" IsOn="{x:Bind ViewModel.SettingsScreenRecordingEnabled, Mode=TwoWay}"/>
                                        <ToggleSwitch AutomationProperties.HelpText="Enable smart redact preview gates." AutomationProperties.Name="Enable smart redact" Header="Smart redact" IsOn="{x:Bind ViewModel.SettingsSmartRedactEnabled, Mode=TwoWay}"/>
                                        <ToggleSwitch AutomationProperties.HelpText="Enable plugin SDK preview gates." AutomationProperties.Name="Enable plugin SDK" Header="Plugin SDK" IsOn="{x:Bind ViewModel.SettingsPluginSdkEnabled, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="12">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Privacy And Transfer"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        AccessKey="V"
                                        AutomationProperties.HelpText="Open SnapStudio privacy notes."
                                        AutomationProperties.Name="Open privacy notes"
                                        Click="OpenPrivacyNoticeButton_Click"
                                        IsEnabled="{x:Bind ViewModel.CanOpenPrivacyNotice, Mode=OneWay}"
                                        ToolTipService.ToolTip="Open privacy notes">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Document"/>
                                            <TextBlock Text="Privacy"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Captures stay local unless exported, copied, or opened outside SnapStudio."
                                        TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid
                        Grid.Row="2"
                        Padding="24,16"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button
                            AccessKey="I"
                            AutomationProperties.HelpText="Import SnapStudio settings from a JSON file."
                            AutomationProperties.Name="Import settings"
                            Click="ImportSettingsButton_Click"
                            IsEnabled="{x:Bind ViewModel.CanImportSettings, Mode=OneWay}"
                            ToolTipService.ToolTip="Import settings">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <controls:WorkspaceIcon Kind="Folder" Width="16" Height="16"/>
                                <TextBlock Text="Import"/>
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="1"
                            AccessKey="E"
                            AutomationProperties.HelpText="Export SnapStudio settings to a JSON file."
                            AutomationProperties.Name="Export settings"
                            Click="ExportSettingsButton_Click"
                            IsEnabled="{x:Bind ViewModel.CanExportSettings, Mode=OneWay}"
                            ToolTipService.ToolTip="Export settings">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Save"/>
                                <TextBlock Text="Export"/>
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="3"
                            AccessKey="F"
                            AutomationProperties.HelpText="{x:Bind ViewModel.SettingsPrimaryActionHelpText, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.SettingsPrimaryActionAutomationName, Mode=OneWay}"
                            Click="CompleteFirstRunSetupButton_Click"
                            HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Accept"/>
                                <TextBlock Text="{x:Bind ViewModel.SettingsPrimaryActionText, Mode=OneWay}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
