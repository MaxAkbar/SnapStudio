                                                            <TextBlock Text="{x:Bind ViewModel.CanvasGridSpacingDescription, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"/>
                                                            <CheckBox Content="Snap to grid" IsChecked="{x:Bind ViewModel.SnapToCanvasGrid, Mode=TwoWay}"
