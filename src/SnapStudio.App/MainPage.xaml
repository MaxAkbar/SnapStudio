                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.AnnotationSizeHeader, Mode=OneWay}" FontSize="10"
                                            VerticalAlignment="Center" Foreground="{ThemeResource SnapMutedBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Grid.Column="1">
                                            <TextBox
                                                x:Name="AnnotationSizeTextBox"
                                                AutomationProperties.HelpText="Enter a stroke width in pixels or a text size. Valid numbers apply immediately and can exceed the slider range."
