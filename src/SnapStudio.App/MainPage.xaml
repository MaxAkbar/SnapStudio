                                        <controls:WorkspaceIcon Kind="Trash" Width="16" Height="16"/>
                                    </Button>
                                </Grid>
                                <Grid x:Name="LayersSectionContent" Grid.Row="1" MinHeight="0" Margin="10,0,10,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
