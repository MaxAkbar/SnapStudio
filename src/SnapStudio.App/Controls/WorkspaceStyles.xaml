<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Merge into the workspace page after XamlControlsResources. Native control
         templates keep their input, selection, flyout, focus and automation behavior.
         Palette resources also supply their hover, pressed and disabled states. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="WorkspacePanelColor">#202228</Color>
            <Color x:Key="WorkspaceCommandColor">#2A2D34</Color>
            <Color x:Key="WorkspaceCommandHoverColor">#353942</Color>
            <Color x:Key="WorkspaceCommandPressedColor">#30343D</Color>
            <Color x:Key="WorkspaceBorderColor">#34373F</Color>
            <Color x:Key="WorkspaceBorderHoverColor">#565C67</Color>
            <Color x:Key="WorkspaceTextColor">#EEF0F4</Color>
            <Color x:Key="WorkspaceMutedColor">#969BA8</Color>
            <Color x:Key="WorkspaceDisabledColor">#6D7380</Color>
            <Color x:Key="WorkspaceIconHoverColor">#333740</Color>
            <Color x:Key="WorkspaceFieldColor">#272A31</Color>
            <Color x:Key="WorkspaceFieldHoverColor">#2B2F37</Color>
            <Color x:Key="WorkspaceFieldFocusedColor">#1E232B</Color>
            <Color x:Key="WorkspaceFieldBorderColor">#3C414A</Color>
            <Color x:Key="WorkspaceAccentColor">#88D2FA</Color>
            <Color x:Key="WorkspaceAccentHoverColor">#B2E2FF</Color>
            <Color x:Key="WorkspaceAccentPressedColor">#6DBEEA</Color>
            <Color x:Key="WorkspaceOnAccentColor">#162B39</Color>
            <Color x:Key="WorkspaceDisabledBackgroundColor">#23262D</Color>
            <Color x:Key="WorkspaceTransparentColor">#00000000</Color>
            <Color x:Key="WorkspaceHeaderHoverColor">#0AFFFFFF</Color>
            <Color x:Key="WorkspaceHeaderPressedColor">#14FFFFFF</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="WorkspacePanelColor" ResourceKey="SystemColorWindowColor"/>
            <StaticResource x:Key="WorkspaceCommandColor" ResourceKey="SystemColorButtonFaceColor"/>
            <StaticResource x:Key="WorkspaceCommandHoverColor" ResourceKey="SystemColorHighlightColor"/>
            <StaticResource x:Key="WorkspaceCommandPressedColor" ResourceKey="SystemColorHighlightColor"/>
            <StaticResource x:Key="WorkspaceBorderColor" ResourceKey="SystemColorButtonTextColor"/>
            <StaticResource x:Key="WorkspaceBorderHoverColor" ResourceKey="SystemColorHighlightColor"/>
            <StaticResource x:Key="WorkspaceTextColor" ResourceKey="SystemColorButtonTextColor"/>
            <StaticResource x:Key="WorkspaceMutedColor" ResourceKey="SystemColorButtonTextColor"/>
            <StaticResource x:Key="WorkspaceDisabledColor" ResourceKey="SystemColorGrayTextColor"/>
            <StaticResource x:Key="WorkspaceIconHoverColor" ResourceKey="SystemColorHighlightColor"/>
            <StaticResource x:Key="WorkspaceFieldColor" ResourceKey="SystemColorWindowColor"/>
            <StaticResource x:Key="WorkspaceFieldHoverColor" ResourceKey="SystemColorWindowColor"/>
            <StaticResource x:Key="WorkspaceFieldFocusedColor" ResourceKey="SystemColorWindowColor"/>
            <StaticResource x:Key="WorkspaceFieldBorderColor" ResourceKey="SystemColorWindowTextColor"/>
            <StaticResource x:Key="WorkspaceAccentColor" ResourceKey="SystemColorHighlightColor"/>
            <StaticResource x:Key="WorkspaceAccentHoverColor" ResourceKey="SystemColorHighlightColor"/>
            <StaticResource x:Key="WorkspaceAccentPressedColor" ResourceKey="SystemColorHighlightColor"/>
            <StaticResource x:Key="WorkspaceOnAccentColor" ResourceKey="SystemColorHighlightTextColor"/>
            <StaticResource x:Key="WorkspaceDisabledBackgroundColor" ResourceKey="SystemColorButtonFaceColor"/>
            <StaticResource x:Key="WorkspaceTransparentColor" ResourceKey="SystemColorWindowColor"/>
            <StaticResource x:Key="WorkspaceHeaderHoverColor" ResourceKey="SystemColorHighlightColor"/>
            <StaticResource x:Key="WorkspaceHeaderPressedColor" ResourceKey="SystemColorHighlightColor"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

