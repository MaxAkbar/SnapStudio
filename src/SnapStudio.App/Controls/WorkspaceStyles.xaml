    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{ThemeResource WorkspaceOnAccentColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{ThemeResource WorkspaceOnAccentColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{ThemeResource WorkspaceAccentColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{ThemeResource WorkspaceAccentHoverColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{ThemeResource WorkspaceAccentPressedColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{ThemeResource WorkspaceAccentColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{ThemeResource WorkspaceAccentHoverColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{ThemeResource WorkspaceAccentPressedColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{ThemeResource WorkspaceOnAccentColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{ThemeResource WorkspaceOnAccentColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{ThemeResource WorkspaceOnAccentColor}"/>
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource WorkspaceRowSelectedColor}"/>
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource WorkspaceRowSelectedHoverColor}"/>
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource WorkspaceRowSelectedPressedColor}"/>
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="{ThemeResource WorkspaceAccentColor}"/>
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="{ThemeResource WorkspaceAccentHoverColor}"/>
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="{ThemeResource WorkspaceAccentPressedColor}"/>
    <SolidColorBrush x:Key="WorkspaceHeaderHoverBrush" Color="{ThemeResource WorkspaceHeaderHoverColor}"/>
    <SolidColorBrush x:Key="WorkspaceHeaderPressedBrush" Color="{ThemeResource WorkspaceHeaderPressedColor}"/>
    <x:Double x:Key="ComboBoxMinHeight">30</x:Double>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

    <Style x:Key="WorkspaceCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource WorkspaceAccentBrush}"/>
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource WorkspacePanelBrush}"/>
        <Setter Property="FocusVisualMargin" Value="2"/>
    </Style>

    <Style x:Key="WorkspaceIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource WorkspaceAccentBrush}"/>
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource WorkspacePanelBrush}"/>
        <Setter Property="FocusVisualMargin" Value="2"/>
    </Style>

    <Style x:Key="WorkspacePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource WorkspaceAccentBrush}"/>
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource WorkspacePanelBrush}"/>
        <Setter Property="FocusVisualMargin" Value="2"/>
    </Style>

    <Style x:Key="WorkspaceTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <!-- Do not fix Height: a native Header or multiline content must still fit. -->
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="WorkspaceComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="9,4,0,4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="MaxDropDownHeight" Value="360"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Only the Expander chrome is replaced. Part names, native visual states
         and the native header toggle preserve its ExpandCollapse automation peer. -->
    <Style x:Key="WorkspaceExpanderHeaderStyle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Background" Value="{ThemeResource WorkspacePanelBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource WorkspaceTextBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource WorkspaceBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource WorkspaceAccentBrush}"/>
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource WorkspacePanelBrush}"/>
        <Setter Property="FocusVisualMargin" Value="-2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="HeaderRoot"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          Padding="{TemplateBinding Padding}"
                          MinHeight="{TemplateBinding MinHeight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HeaderRoot.Background" Value="{ThemeResource WorkspaceHeaderHoverBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HeaderRoot.Background" Value="{ThemeResource WorkspaceHeaderPressedBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextControlForegroundDisabled}"/>
                                        <Setter Target="Chevron.Foreground" Value="{ThemeResource TextControlForegroundDisabled}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="ChevronRotation.Angle" Value="90"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ChevronRotation.Angle" Value="90"/>
                                        <Setter Target="HeaderRoot.Background" Value="{ThemeResource WorkspaceHeaderHoverBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="ChevronRotation.Angle" Value="90"/>
                                        <Setter Target="HeaderRoot.Background" Value="{ThemeResource WorkspaceHeaderPressedBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="HeaderContent"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="0,0,10,0"
                                          AutomationProperties.AccessibilityView="Raw"/>
                        <FontIcon x:Name="Chevron" Grid.Column="1"
                                  Glyph="&#xE76C;" FontSize="10"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  Foreground="{ThemeResource WorkspaceMutedBrush}"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"
                                  RenderTransformOrigin="0.5,0.5"
                                  AutomationProperties.AccessibilityView="Raw">
                            <FontIcon.RenderTransform>
                                <RotateTransform x:Name="ChevronRotation"/>
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WorkspaceExpanderStyle" TargetType="Expander">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource WorkspaceTextBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource WorkspaceBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <!-- Padding controls the header inset; content owns its own spacing. -->
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid MinWidth="{TemplateBinding MinWidth}" MaxWidth="{TemplateBinding MaxWidth}">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="HeaderRow" Height="Auto"/>
                            <RowDefinition x:Name="ContentRow" Height="*"/>
                        </Grid.RowDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ExpandStates">
                                <VisualState x:Name="ExpandDown">
                                    <VisualState.Setters>
                                        <Setter Target="ExpanderContent.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="ExpandUp">
                                    <VisualState.Setters>
                                        <Setter Target="ExpanderContent.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CollapseDown"/>
                                <VisualState x:Name="CollapseUp"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ExpandDirectionStates">
                                <VisualState x:Name="Down"/>
                                <VisualState x:Name="Up">
                                    <VisualState.Setters>
                                        <Setter Target="ExpanderHeader.(Grid.Row)" Value="1"/>
                                        <Setter Target="ExpanderContentClip.(Grid.Row)" Value="0"/>
                                        <Setter Target="HeaderRow.Height" Value="*"/>
                                        <Setter Target="ContentRow.Height" Value="Auto"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ToggleButton x:Name="ExpanderHeader"
                                      AutomationProperties.AutomationId="ExpanderToggleButton"
                                      Style="{StaticResource WorkspaceExpanderHeaderStyle}"
                                      MinHeight="{TemplateBinding MinHeight}"
                                      Padding="{TemplateBinding Padding}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      IsEnabled="{TemplateBinding IsEnabled}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Border x:Name="ExpanderContentClip" Grid.Row="1">
                            <Border x:Name="ExpanderContent"
                                    Visibility="Collapsed"
                                    Background="{TemplateBinding Background}"
                                    Padding="0">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <Border.RenderTransform>
                                    <CompositeTransform/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WorkspaceLayerExpanderStyle" TargetType="Expander" BasedOn="{StaticResource WorkspaceExpanderStyle}">
        <Setter Property="MinHeight" Value="46"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
</ResourceDictionary>
