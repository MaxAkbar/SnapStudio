    <SolidColorBrush x:Key="WorkspaceBorderBrush" Color="{ThemeResource WorkspaceBorderColor}"/>
    <SolidColorBrush x:Key="WorkspaceTextBrush" Color="{ThemeResource WorkspaceTextColor}"/>
    <SolidColorBrush x:Key="WorkspaceMutedBrush" Color="{ThemeResource WorkspaceMutedColor}"/>
    <SolidColorBrush x:Key="WorkspaceAccentBrush" Color="{ThemeResource WorkspaceAccentColor}"/>
    <SolidColorBrush x:Key="WorkspaceOnAccentBrush" Color="{ThemeResource WorkspaceOnAccentColor}"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource WorkspaceCommandColor}"/>
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource WorkspaceCommandHoverColor}"/>
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource WorkspaceCommandPressedColor}"/>
