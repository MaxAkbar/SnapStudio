<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsAppSdkSelfContained>true</WindowsAppSdkSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <!-- Exercise the UI-independent collection updater without loading WinUI into the test host. -->
    <Compile Include="..\..\src\SnapStudio.App\ViewModels\CollectionUpdates.cs" Link="App\CollectionUpdates.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SnapStudio.Core\SnapStudio.Core.csproj" />
    <ProjectReference Include="..\..\src\SnapStudio.Storage\SnapStudio.Storage.csproj" />
    <ProjectReference Include="..\..\src\SnapStudio.Ipc\SnapStudio.Ipc.csproj" />
    <ProjectReference Include="..\..\src\SnapStudio.Platform.Windows\SnapStudio.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\src\SnapStudio.Rendering\SnapStudio.Rendering.csproj" />
  </ItemGroup>

</Project>
